# Copy to .env only if you do not already have one. Never commit credentials.
# Node does not automatically load this file; see README.md.

# Required for the local server. Use a disposable database for development/tests.
DATABASE_URL=
# Generate a unique, high-entropy secret. Also protects stored private identity
# data; do not rotate an existing deployment's secret without a migration plan.
SESSION_SECRET=
PORT=5000
# Optional locally; match PORT if changed. Production requires an HTTPS origin.
PUBLIC_APP_URL=http://localhost:5000
# Required at build time; set to the intended public HTTPS site origin.
PRODUCTION_SITE_URL=

# Leave unset locally. Live campaigns require NODE_ENV=production and
# WEBSITE_SLOT_NAME=production; verify actual slot behavior before deployment.
# WEBSITE_SLOT_NAME=

# Azure Blob: choose ONE authentication method. Create both private containers.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_PRIVATE_CONTAINER=private
AZURE_STORAGE_PUBLIC_CONTAINER=public
AZURE_STORAGE_PUBLIC_SEARCH_PATHS=

# Optional external services: leave blank until individually configured.
OPENAI_API_KEY=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Currently only used for startup status, not for Twilio Verify calls.
TWILIO_VERIFY_SERVICE_SID=
RINGCENTRAL_ENVIRONMENT=sandbox
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT_TOKEN=
RINGCENTRAL_PHONE_NUMBER=
UDC_WEBHOOK_KEY=

# Optional single-tenant Entra sign-in; password sign-in stays enabled.
AUTH_ENABLE_ENTRA_ID=false
OIDC_TENANT_ID=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
OIDC_POST_LOGOUT_REDIRECT_URL=

# Optional inherited integrations; do not enable without explicit approval.
NER_API_URL=
NER_REGISTRATION_PATH=
SAL_API_URL=

# For the explicit, one-time db:bootstrap-admin command only; never needed at
# application startup. Supply securely outside this file and remove afterward.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_LAST_NAME=
